# services/chatbot — environment variables for run-mcp.sh / run-gateway.sh
# Copy to `.env` (gitignored) and tweak as needed.

# ---------------------------------------------------------------------------
# Gateway (dremio-sql-agent, FastAPI on :9292)
# ---------------------------------------------------------------------------

# Host/port that uvicorn binds.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9292

# MCP endpoint the gateway talks to (Streaming HTTP). Must match
# `run-mcp.sh` output (port 8080 by default).
DREMIO_MCP_URL=http://127.0.0.1:8080/mcp/

# Optional MCP tunings.
DREMIO_MCP_TIMEOUT_SECONDS=120
DREMIO_MCP_SSE_READ_TIMEOUT_SECONDS=7200
DREMIO_MCP_TOOLS_CACHE_TTL=300

# Wall-clock cap for one /aichat/v1/chat call. Unset/0 = unlimited.
AGENT_REQUEST_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# LLM (Ollama on :11434)
# ---------------------------------------------------------------------------

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Qwen 3.x runs in "thinking" mode and tends to time out for structured SQL;
# 2.5 is the verified default. Override for GPU hosts.
OLLAMA_MODEL=qwen2.5:3b
# Streaming defaults OFF (some models hang after HTTP 200). Set to 1 to enable.
OLLAMA_STREAM=0

# ---------------------------------------------------------------------------
# Agent tracing
# ---------------------------------------------------------------------------

AGENT_TRACE_LOG=1
AGENT_TRACE_VERBOSE=1
AGENT_TRACE_LLM_CONTENT=0

# ---------------------------------------------------------------------------
# Dremio side (consumed by the DAC reverse-proxy; mirror what dremio.conf has)
# ---------------------------------------------------------------------------

# Optional: overrides services.coordinator.web.chatbot.gateway.base_url
# when starting Dremio from this shell. Same value as `GATEWAY_PORT` above.
DREMIO_CHATBOT_GATEWAY_BASE_URL=http://127.0.0.1:9292

# Legacy alias (still honoured by the resolver). Prefer the variable above.
# DREMIO_AICHATBOT_PLUGIN_BASE_URL=http://127.0.0.1:9292
